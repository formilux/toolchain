# Support building from x86_64

--- ./config.sub.bad	2024-08-13 10:59:01.912103475 +0200
+++ ./config.sub	2024-08-13 11:02:44.645929327 +0200
@@ -198,7 +198,7 @@
 	# We use `pc' rather than `unknown'
 	# because (1) that's what they normally are, and
 	# (2) the word "unknown" tends to confuse beginning users.
-	i[34567]86)
+	i[34567]86 | x86*)
 	  basic_machine=$basic_machine-pc
 	  ;;
 	# Object if more than one company name word.
--- gcc-20011006/gcc/configure.bad	2024-08-13 11:04:00.362870132 +0200
+++ gcc-20011006/gcc/configure	2024-08-13 11:08:45.640647127 +0200
@@ -2926,7 +2926,7 @@
 	c*-convex-*)
 		cpu_type=convex
 		;;
-	i[34567]86-*-*)
+	i[34567]86-*-* | x86*)
 		cpu_type=i386
 		;;
 	hppa*-*-*)
@@ -3631,7 +3631,7 @@
  			thread_file='single'
  		fi
 		;;
-	i[34567]86-*-linux-gnu*)	# Intel 80386's running GNU/Linux
+	i[34567]86-*-linux-gnu* | x86*-linux-gnu*)	# Intel 80386's running GNU/Linux
 					# aka GNU/Linux C library 6
 		xmake_file=x-linux
 		tm_file=i386/linux.h
